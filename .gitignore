# Node.js dependencies folder — never upload this to GitHub
# It is regenerated automatically by running: npm install
node_modules/

# Environment variables file — contains sensitive data like passwords/API keys
.env

# macOS system files (not needed in your project)
.DS_Store

# Windows system files
Thumbs.db

# Log files generated by npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock
